{
  "manifestVersion": 5,
  "id": "com.yourname.metsuke",
  "name": "Metsuke",
  "version": "1.0.0",
  "main": "index.html",
  "description": "フォルダ自動同期 Premiere Pro UXPプラグイン / Watch folder auto-sync plugin for Premiere Pro",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "metsuke-panel",
      "label": {
        "default": "Metsuke"
      },
      "minimumSize": { "width": 300, "height": 400 },
      "preferredDockedSize": { "width": 350, "height": 550 },
      "maximumSize": { "width": 800, "height": 1200 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": ["file"],
      "extensions": [
        ".mp3", ".wav", ".aac", ".ogg", ".m4a", ".flac",
        ".mp4", ".mov", ".avi", ".mkv",
        ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff", ".tif"
      ]
    }
  }
}
